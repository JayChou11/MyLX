<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysWarningRecordMapper">
    
    <resultMap type="SysWarningRecord" id="SysWarningRecordResult">
        <result property="warningId"    column="warning_id"    />
        <result property="scoreId"    column="score_id"    />
        <result property="studentId"    column="student_id"    />
        <result property="examId"    column="exam_id"    />
        <result property="warningType"    column="warning_type"    />
        <result property="warningLevel"    column="warning_level"    />
        <result property="warningItem"    column="warning_item"    />
        <result property="warningReason"    column="warning_reason"    />
        <result property="warningStatus"    column="warning_status"    />
        <result property="handleResult"    column="handle_result"    />
        <result property="handleTime"    column="handle_time"    />
        <result property="handlerId"    column="handler_id"    />
        <result property="handlerName"    column="handler_name"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysWarningRecordVo">
        select warning_id, score_id, student_id, exam_id, warning_type, warning_level, warning_item, warning_reason, warning_status, handle_result, handle_time, handler_id, handler_name, create_by, create_time, update_by, update_time, remark from sys_score_warning_record
    </sql>

    <select id="selectSysWarningRecordList" parameterType="SysWarningRecord" resultMap="SysWarningRecordResult">
        <include refid="selectSysWarningRecordVo"/>
        <where>  
            <if test="scoreId != null"> and score_id = #{scoreId}</if>
            <if test="studentId != null"> and student_id = #{studentId}</if>
            <if test="examId != null"> and exam_id = #{examId}</if>
            <if test="warningType != null  and warningType != ''"> and warning_type = #{warningType}</if>
            <if test="warningLevel != null  and warningLevel != ''"> and warning_level = #{warningLevel}</if>
            <if test="warningItem != null  and warningItem != ''"> and warning_item like concat('%', #{warningItem}, '%')</if>
            <if test="warningStatus != null  and warningStatus != ''"> and warning_status = #{warningStatus}</if>
            <if test="handlerName != null  and handlerName != ''"> and handler_name like concat('%', #{handlerName}, '%')</if>
        </where>
    </select>
    
    <select id="selectSysWarningRecordByWarningId" parameterType="Long" resultMap="SysWarningRecordResult">
        <include refid="selectSysWarningRecordVo"/>
        where warning_id = #{warningId}
    </select>

    <!-- 按唯一键查询预警记录 -->
    <select id="selectByScoreIdAndTypeAndItem" resultMap="SysWarningRecordResult">
        <include refid="selectSysWarningRecordVo"/>
        where score_id = #{scoreId}
        and warning_type = #{warningType}
        and warning_item = #{warningItem}
    </select>

    <insert id="insertSysWarningRecord" parameterType="SysWarningRecord" useGeneratedKeys="true" keyProperty="warningId">
        insert into sys_score_warning_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="scoreId != null">score_id,</if>
            <if test="studentId != null">student_id,</if>
            <if test="examId != null">exam_id,</if>
            <if test="warningType != null and warningType != ''">warning_type,</if>
            <if test="warningLevel != null and warningLevel != ''">warning_level,</if>
            <if test="warningItem != null and warningItem != ''">warning_item,</if>
            <if test="warningReason != null and warningReason != ''">warning_reason,</if>
            <if test="warningStatus != null and warningStatus != ''">warning_status,</if>
            <if test="handleResult != null and handleResult != ''">handle_result,</if>
            <if test="handlerName != null and handlerName != ''">handler_name,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="handlerId != null">handler_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="scoreId != null">#{scoreId},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="examId != null">#{examId},</if>
            <if test="warningType != null and warningType != ''">#{warningType},</if>
            <if test="warningLevel != null and warningLevel != ''">#{warningLevel},</if>
            <if test="warningItem != null and warningItem != ''">#{warningItem},</if>
            <if test="warningReason != null and warningReason != ''">#{warningReason},</if>
            <if test="warningStatus != null and warningStatus != ''">#{warningStatus},</if>
            <if test="handleResult != null and handleResult != ''">#{handleResult},</if>
            <if test="handlerName != null and handlerName != ''">#{handlerName},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="handlerId != null">#{handlerId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysWarningRecord" parameterType="SysWarningRecord">
        update sys_score_warning_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="warningType != null and warningType != ''">warning_type = #{warningType},</if>
            <if test="warningLevel != null and warningLevel != ''">warning_level = #{warningLevel},</if>
            <if test="warningItem != null">warning_item = #{warningItem},</if>
            <if test="warningReason != null">warning_reason = #{warningReason},</if>
            <if test="warningStatus != null">warning_status = #{warningStatus},</if>
            <if test="handleResult != null">handle_result = #{handleResult},</if>
            <if test="handlerName != null and handlerName != ''">handler_name = #{handlerName},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="handlerId != null">handler_id = #{handlerId},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where warning_id = #{warningId}
        and warning_status = '0'
    </update>

    <delete id="deleteSysWarningRecordByWarningId" parameterType="Long">
        delete from sys_score_warning_record where warning_id = #{warningId}
    </delete>

    <delete id="deleteSysWarningRecordByWarningIds" parameterType="String">
        delete from sys_score_warning_record where warning_id in
        <foreach item="warningId" collection="array" open="(" separator="," close=")">
            #{warningId}
        </foreach>
    </delete>
</mapper>
